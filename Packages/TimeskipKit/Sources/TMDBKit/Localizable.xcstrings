    "Too many requests. Try again in a moment.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas requisições. Tente de novo em instantes."
          }
        }
      }
    },
    "You're offline": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
